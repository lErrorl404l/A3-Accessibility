#!/usr/bin/env bash
# Fast gates for the A3 Accessibility repository.
# Runs the lint check and the offline palette test. Plan section 7.6.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
FAILED=0

if command -v hemtt >/dev/null 2>&1; then
    echo "-> hemtt check"
    (cd "$ROOT" && hemtt check) || FAILED=1
else
    echo "WARN hemtt not found, skipping the lint check"
fi

if command -v python3 >/dev/null 2>&1 && [ -f "$ROOT/tests/verify_palette.py" ]; then
    echo "-> python3 tests/verify_palette.py"
    (cd "$ROOT" && python3 tests/verify_palette.py) || FAILED=1
else
    echo "WARN tests/verify_palette.py not found, skipping the offline palette test"
fi

if [ "$FAILED" -ne 0 ]; then
    echo "X pre-commit failed. Fix the errors, then commit again."
    exit 1
fi

echo "OK pre-commit checks passed"
