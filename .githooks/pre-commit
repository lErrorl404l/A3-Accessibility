#!/usr/bin/env bash
# Fast gates for the A3 Accessibility repository.
# Runs the lint check and every offline gate that needs no game install.
# tests/verify_shipped.py is excluded: it needs the extracted game configs.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
FAILED=0

if command -v hemtt >/dev/null 2>&1; then
    echo "-> hemtt check"
    (cd "$ROOT" && hemtt check) || FAILED=1
else
    echo "WARN hemtt not found, skipping the lint check"
fi

if command -v python3 >/dev/null 2>&1; then
    for gate in verify_palette verify_postprocess verify_surface verify_objective_panel; do
        script="$ROOT/tests/$gate.py"
        if [ -f "$script" ]; then
            echo "-> python3 tests/$gate.py"
            (cd "$ROOT" && python3 "$script" >/dev/null) || FAILED=1
        else
            echo "WARN tests/$gate.py not found, skipping it"
        fi
    done
else
    echo "WARN python3 not found, skipping the offline gates"
fi

if [ "$FAILED" -ne 0 ]; then
    echo "X pre-commit failed. Fix the errors, then commit again."
    exit 1
fi

echo "OK pre-commit checks passed"
